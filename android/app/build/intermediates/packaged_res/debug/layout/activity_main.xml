<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Move Hub • Porsche + Lamborghini" android:textSize="23sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Pred pripojením / kalibráciou ODPOJTE USB-C a zdvihnite kolesá. Riadenie sa pri kalibrácii pohybuje. Počas nabíjania motory nefungujú."
        android:textSize="15sp" android:textColor="#9C3200" />
    <Button android:id="@+id/emergency" android:layout_width="match_parent" android:layout_height="64dp"
        android:text="STOP ALL — ZASTAVIŤ OBA HUBY" android:textStyle="bold" android:textSize="18sp"
        android:textColor="#FFFFFF" android:backgroundTint="#B71C1C" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout android:id="@+id/cards" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
